{
  "name": "campus-agent-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "四人协作的 ArkUI-X AI Agent 应用框架；Node 仅用于共享逻辑验证",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/framework.test.mjs tests/speech.test.mjs tests/integration.test.mjs tests/calendar.test.mjs",
    "verify:model": "node --disable-warning=ExperimentalWarning scripts/verify-model.mjs",
    "verify:deepseek": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env.local scripts/verify-model.mjs --deepseek",
    "verify:calendar": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env.local scripts/verify-model.mjs --deepseek --calendar",
    "check": "node --disable-warning=ExperimentalWarning scripts/check.mjs"
  }
}
