{
  "name": "campus-agent-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "前后端分离的学习规划 Agent 工程：ArkUI-X 客户端与 Java Spring Boot 后端",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "prepare:model": "node scripts/prepare-model-config.mjs",
    "test": "node --disable-warning=ExperimentalWarning scripts/check.mjs",
    "test:frontend": "npm run test",
    "dev:backend": "node --env-file-if-exists=.env.local scripts/backend.mjs run",
    "test:backend": "node --env-file-if-exists=.env.local scripts/backend.mjs test",
    "build:backend": "node --env-file-if-exists=.env.local scripts/backend.mjs package",
    "verify:backend": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env.local scripts/verify-backend.mjs",
    "check:all": "npm run check && npm run test:backend",
    "verify:model": "node --disable-warning=ExperimentalWarning scripts/verify-model.mjs",
    "verify:deepseek": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env.local scripts/verify-model.mjs --deepseek",
    "verify:calendar": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env.local scripts/verify-model.mjs --deepseek --calendar",
    "check": "node --disable-warning=ExperimentalWarning scripts/check.mjs"
  }
}
