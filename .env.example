# 复制为 .env.local 后填入本机密钥；不要提交 .env.local。
DEEPSEEK_API_KEY=
# 默认使用 services/model/DeepSeekConfig.ts 中的官方模型。
# DEEPSEEK_MODEL=deepseek-flash

# Java 后端本地开发；后端启动、测试、构建命令会加载根目录 .env.local。
# JAVA_HOME=D:\JAVA
# SERVER_PORT=8080
# SERVER_ADDRESS=127.0.0.1
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 仅用于接口联调脚本，不是移动设备的后端地址。
# BACKEND_BASE_URL=http://127.0.0.1:8080
# ArkUI-X 本地联调使用电脑上的 Java 后端，留空使用端内模式。
ARKUI_BACKEND_URL=http://127.0.0.1:8080
# 发布客户端时，将上面一行的值替换为服务器 HTTPS 地址。
# ARKUI_BACKEND_URL=https://api.kaleteam.cn
# 只有在 Java 位于可信 TLS 反向代理之后时才启用转发头。
# SERVER_FORWARD_HEADERS_STRATEGY=native
# Java 后端持久化目录（相对于服务工作目录，也可指定绝对路径）。
# APP_DATA_DIRECTORY=./backend-data
# 可选：Java 后端的默认模型和允许运行时切换的附加 HTTPS 接口。
# APP_MODEL_ENDPOINT=https://api.deepseek.com/chat/completions
# APP_MODEL_NAME=deepseek-flash
# APP_MODEL_API_KEY=
# 自定义密钥存储专用。使用 openssl rand -base64 32 生成，部署后保持固定。
# APP_MODEL_CREDENTIAL_KEY=
# APP_MODEL_ALLOWED_ENDPOINTS=
# 网页搜索与读取默认使用 DEEPSEEK_API_KEY。可用下列变量覆盖为专用 DeepSeek 密钥。
# APP_WEB_API_KEY=
